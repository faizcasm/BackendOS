{
  "name": "backendos",
  "version": "2.0.0",
  "description": "An operating system for production backends: modular monolith with auth, rate limiting, caching, jobs, uploads, logging, monitoring and AI helpers.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "backendos": "dist/server.js"
  },
  "files": [
    "dist",
    "prisma/schema.prisma",
    ".env.example"
  ],
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"ts-node src/server.ts\"",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:dev": "ts-node src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "example:basic": "ts-node examples/basic-server.ts",
    "example:full": "ts-node examples/full-featured.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"prisma/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"prisma/**/*.ts\"",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test:ci && npm run build"
  },
  "keywords": [
    "backend",
    "saas",
    "modular-monolith",
    "authentication",
    "rate-limiting",
    "caching",
    "background-jobs",
    "file-upload",
    "logging",
    "monitoring",
    "ai-helpers",
    "express",
    "prisma",
    "bullmq",
    "typescript"
  ],
  "author": "faizcasm",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faizcasm/BackendOS.git"
  },
  "bugs": {
    "url": "https://github.com/faizcasm/BackendOS/issues"
  },
  "homepage": "https://github.com/faizcasm/BackendOS#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
    "@aws-sdk/s3-request-presigner": "^3.958.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.66.4",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^6.0.1",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^10.12.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
