# ─────────────────────────────────────────────────────────────────────────────
# BackendOS environment configuration
# Copy to `.env` and adjust. Values marked (required) must be set in production.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Number of proxy hops in front of the API (1 for a load balancer, 0 for none).
# Never set this to `true` — it lets clients spoof their IP for rate limiting.
TRUST_PROXY=0
BODY_LIMIT=1mb
# Comma separated list, or * to allow any origin (development default)
CORS_ORIGINS=*
SHUTDOWN_TIMEOUT_MS=10000

# Database (required) — PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/backendos?schema=public"

# Redis (optional in development, recommended in production)
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Fail startup when Redis is unreachable
REDIS_REQUIRED=false

# Authentication (required in production — use long random strings, e.g.
# `openssl rand -base64 48`)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File uploads
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,text/plain,application/json
# local (disk) or s3 (S3/MinIO/R2 compatible)
STORAGE_DRIVER=local

# S3 compatible storage (required when STORAGE_DRIVER=s3)
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=backendos-files
S3_REGION=us-east-1

# AI providers (optional — the /api/ai routes return 503 without them)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_TIMEOUT_MS=30000

# Logging & observability
LOG_LEVEL=info
# Write logs/combined.log and logs/error.log in addition to stdout
LOG_FILE_ENABLED=false
METRICS_ENABLED=true
METRICS_PATH=/metrics
# Optional bearer token protecting the metrics endpoint
METRICS_TOKEN=
# Interactive API documentation
DOCS_ENABLED=true
DOCS_PATH=/api/docs

# Module toggles (true/false)
MODULE_AUTH=true
MODULE_RATE_LIMITING=true
MODULE_CACHING=true
MODULE_JOBS=true
MODULE_FILE_UPLOAD=true
MODULE_LOGGING=true
MODULE_MONITORING=true
MODULE_AI_HELPERS=true
MODULE_AUDIT=true
MODULE_DOCS=true

# Seed script (npm run prisma:seed)
SEED_ADMIN_EMAIL=admin@backendos.local
SEED_ADMIN_PASSWORD=
